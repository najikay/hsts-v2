<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  ConnectView — splash / connection screen (Presentation tier).
  Controller is set via loader.setController(this) in render() (no fx:controller),
  keeping the AbstractScreenUI / ScreenManager wiring intact. Shown first by
  ClientApp; on a successful connect it asks ScreenManager to swap to QuestionsView.
-->
<StackPane prefHeight="430.0" prefWidth="480.0" styleClass="connect-root"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <VBox fx:id="card" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="connect-card">
        <StackPane fx:id="logoBox"/>
        <Label styleClass="connect-wordmark" text="HSTS"/>
        <Label styleClass="connect-title" text="High School Test System"/>
        <Label styleClass="connect-subtitle" text="Question Management Prototype"/>

        <ProgressIndicator fx:id="spinner" prefHeight="46.0" prefWidth="46.0" progress="-1.0"/>

        <Label fx:id="statusLabel" styleClass="connect-status" text="Connecting to server…"/>

        <Label fx:id="errorLabel" managed="false" maxWidth="280.0" styleClass="connect-error"
               textAlignment="CENTER" visible="false" wrapText="true"/>

        <Button fx:id="retryButton" managed="false" onAction="#onRetry" styleClass="primary-button"
                text="Retry" visible="false"/>
    </VBox>
</StackPane>
