<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration (E0.4, completed in E3.6 / E19.4).

  Two appenders, two audiences:

    CONSOLE  the terminal stream the defence is run from (F13.1).
    RING     the in-memory ring buffer the JavaFX server console tails (E19.4).

  The rolling file appender E3.6 also asks for is deliberately still absent: it
  would write a log directory on every test run of this single-module build, and
  it belongs with the rest of E3.6 rather than smuggled in beside the ring buffer.

  RING is declared HERE rather than attached from Java on purpose: an appender
  added programmatically only starts collecting once that code runs, which would
  be after config loading, after Flyway and after the pool comes up. Those are
  exactly the lines an operator wants when a first boot goes wrong, so the
  appender is configured with the framework and is already capturing before the
  first line of ServerMain executes. The console finds it through
  RingBufferAppender.buffer().
-->
<configuration>

    <!--
      The defence view (E20.3). The terminal the server is started from is on the
      projector for the whole session, so the stream is formatted to be read at a
      glance from the back of a room rather than grepped afterwards:

        08:41:36.204 INFO  s.features.exams.ExamService  Exam 12 started for 3 students
        ^ gray, quiet ^ coloured by severity  ^ cyan, one column  ^ plain, the part being read

      %logger{30} shortens leading packages only as far as it has to, so the
      feature and the class survive (s.features.exams.ExamService) where a tighter
      target would have left s.f.e.ExamService and made every line look alike.

      Colour comes from logback's own %highlight / %gray / %cyan converters, which
      write plain ANSI escapes. Nothing is added to the classpath for it: Windows
      Terminal and PowerShell 5+ render those natively, which is what the demo
      machines run. A terminal with no ANSI support (a bare legacy conhost) prints
      the escapes literally, and the fix on the day is to open Windows Terminal,
      never to rebuild.

      Width modifiers sit INSIDE each colour converter (%cyan(%-28.28logger{30})),
      never around it. Padding applied outside would be counting escape characters
      as if they were letters and every column would drift.

      Only the terminal is coloured. The console window's log pane reads from RING
      below, which formats events itself and never sees this pattern (E19.4), so a
      change here cannot leak escape codes into the JavaFX view.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%gray(%d{HH:mm:ss.SSS}) %highlight(%-5level) %cyan(%-28.28logger{30}) %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="RING" class="server.console.RingBufferAppender">
        <capacity>2000</capacity>
    </appender>

    <!-- Our own code: debug-friendly during development -->
    <logger name="client" level="DEBUG"/>
    <logger name="server" level="DEBUG"/>
    <logger name="common" level="DEBUG"/>

    <!-- Third-party noise floor -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="RING"/>
    </root>

</configuration>
