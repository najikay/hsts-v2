<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hsts</groupId>
    <artifactId>hsts</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>HSTS v2</name>
    <description>High School Test System — 3-tier Thin Client / Fat Server (JavaFX 21 + OCSF + MySQL)</description>

    <properties>
        <!-- ===== Build ===== -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Reproducible builds (E0.3): fixed archive entry timestamps -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

        <!-- Fat-JAR naming (E20.1).

             Dev builds keep the lower-case names every script, README line and
             muscle memory in this repo already uses:

                 mvn package                 ->  hsts-server.jar / hsts-client.jar

             The submission build passes the group number on the command line,
             which activates the `submission-jar-names` profile below and switches
             both JARs to the exact names the spec asks for:

                 mvn -Djar.prefix=G13 package ->  G13_Server.jar / G13_Client.jar

             The group number is never written into this file: one CLI switch is
             harder to forget on the day than an edit-then-remember-to-revert. -->
        <jar.prefix>hsts</jar.prefix>
        <jar.server.name>${jar.prefix}-server</jar.server.name>
        <jar.client.name>${jar.prefix}-client</jar.client.name>

        <!-- ===== Runtime dependency versions ===== -->
        <javafx.version>21.0.4</javafx.version>
        <atlantafx.version>2.0.1</atlantafx.version>
        <ikonli.version>12.3.1</ikonli.version>
        <eventbus.version>3.3.1</eventbus.version>
        <hibernate.version>6.6.4.Final</hibernate.version>
        <mysql.version>8.4.0</mysql.version>
        <hikaricp.version>5.1.0</hikaricp.version>
        <flyway.version>10.20.1</flyway.version>
        <bcrypt.version>0.10.2</bcrypt.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.12</logback.version>
        <pdfbox.version>3.0.3</pdfbox.version>
        <poi.version>5.3.0</poi.version>
        <anthropic.version>2.34.0</anthropic.version>
        <jackson.version>2.17.2</jackson.version>

        <!-- ===== Test dependency versions ===== -->
        <junit.version>5.10.3</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <assertj.version>3.26.3</assertj.version>
        <h2.version>2.3.232</h2.version>
        <testfx.version>4.0.18</testfx.version>
        <monocle.version>21.0.2</monocle.version>

        <!-- ===== Plugin versions ===== -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
        <jacoco-plugin.version>0.8.12</jacoco-plugin.version>

        <!-- ===== Coverage gate (ADR-014) ===== -->
        <jacoco.min.instruction.coverage>0.90</jacoco.min.instruction.coverage>
    </properties>

    <dependencies>
        <!-- ===================== Presentation tier ===================== -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Design system: AtlantaFX theme + Ikonli material icons (ADR-006) -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-material2-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>

        <!-- Client event bus (ADR-007) -->
        <dependency>
            <groupId>org.greenrobot</groupId>
            <artifactId>eventbus-java</artifactId>
            <version>${eventbus.version}</version>
        </dependency>

        <!-- ===================== Data tier (ADR-004) ===================== -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- ===================== Security (ADR-005) ===================== -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>${bcrypt.version}</version>
        </dependency>

        <!-- ===================== Logging ===================== -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- ============ Bot source extraction + providers (ADR-009) ============ -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- OCSF networking is native to the source tree (src/main/java/ocsf/**) —
             vendored, untouched, no external dependency. -->

        <!-- ===================== Test scope ===================== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            UI smoke tests (E4.24). TestFX drives a real JavaFX toolkit; Monocle
            is the headless software renderer that lets it run on a CI box with
            no display. Both are test-scope only and never reach either Fat JAR.
        -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>${testfx.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>${monocle.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler: Java 21 (ADR-002) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Guard: this project builds only on JDK 21 (newer JDKs break Mockito/ByteBuddy) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-jdk-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>HSTS builds with JDK 21 (Temurin). Newer JDKs break Mockito/ByteBuddy — install Temurin 21 and set JAVA_HOME.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Unit tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- @{argLine} picks up the JaCoCo agent set by prepare-agent -->
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>

            <!-- Coverage gate ≥90% instruction (ADR-014) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-plugin.version}</version>
                <configuration>
                    <excludes>
                        <!-- vendored, never modified -->
                        <exclude>ocsf/**</exclude>
<!-- E5 feature screens: ONLY the thin FX view classes are excluded, listed one by
                             one. Every feature LOGIC class IS measured and tested —
                             connect/ConnectWiring, login/LoginSession, login/ShellBoot,
                             home/HomeGreeting, home/StudentHomeSession. Note the classes are
                             listed individually rather than as client/features/*/…View*: a
                             single '*' in JaCoCo crosses path separators, so one wildcard here
                             would silently un-instrument whole logic subpackages. -->
                        <exclude>client/features/connect/ConnectView*</exclude>
                        <exclude>client/features/login/LoginView*</exclude>
                        <!-- client/features/bank/QuestionsView* stood here; the legacy screen
                             retired with its FXML, its scoped app.css and its two verbs. The
                             versioned bank's own view is excluded further down. -->
                        <exclude>client/features/settings/SettingsView*</exclude>
                        <exclude>client/features/home/DashboardPage*</exclude>
                        <exclude>client/features/home/TeacherHomeView*</exclude>
                        <exclude>client/features/home/CoordinatorHomeView*</exclude>
                        <exclude>client/features/home/StudentHomeView*</exclude>
                        <exclude>client/features/home/PrincipalHomeView*</exclude>
<!-- E17/E18 thin FX views. Every decision they render lives in a measured
                             logic class next to them — NotificationsModel, NotificationPresenter,
                             NotificationsSession, EditLockState, LockAwareEditor, LockCopy — and
                             the panel is additionally driven by a real-input TestFX test
                             (NotificationsInteractionTest). Listed one by one, never as a
                             wildcard: a single '*' crosses path separators in JaCoCo. -->
                        <exclude>client/features/notify/NotificationsPanel*</exclude>
                        <exclude>client/features/locks/LockBanner*</exclude>
                        <exclude>client/features/locks/FxHeartbeat*</exclude>
<!-- E10/E11 take-exam and monitor: the five thin FX views only, listed one by
                             one. Every decision they render lives in a measured logic class
                             beside them — ExamEntrySession, ExamAttemptSession, AttemptModel,
                             ExecutionMonitorSession, ExamCopy, ExamClock, SaveState,
                             QuestionChip, DelayedRunner — and the screens are additionally
                             driven by real-input TestFX tests (TakeExamInteractionTest,
                             ExecutionMonitorInteractionTest) covering the entry flow, the
                             live form, the Time Extended moment and the Time Up takeover.
                             Never a wildcard: a single '*' crosses path separators in JaCoCo
                             and would silently un-instrument the whole feature. -->
                        <exclude>client/features/exam/TakeExamView*</exclude>
                        <exclude>client/features/exam/ExamEntryView*</exclude>
                        <exclude>client/features/exam/ExamFormView*</exclude>
                        <exclude>client/features/exam/ExamDoneView*</exclude>
                        <exclude>client/features/exam/AnswerGridView*</exclude>
                        <exclude>client/features/exam/ExecutionMonitorView*</exclude>
                        <exclude>client/features/exam/QuestionCardView*</exclude>
<!-- E9 release manager: the one thin FX screen plus the one dialog that needs
                             inputs and so could not reuse WarnConfirm. Every decision they
                             render lives in a measured class beside them — ReleaseManagerSession
                             (the list, the pushes, the local validation, the sticky code
                             reveal) and ReleaseCopy (every sentence, checked against the §4.1
                             rules) — while which actions a row offers is decided on the wire by
                             common.dto.release.ReleaseState/ReleaseRow and the window and code
                             rules by ReleaseCreateRequest, all of which are covered. The create
                             dialog's own decisions live in its public Form, which the
                             interaction test builds and drives directly because a modal
                             showAndWait cannot be driven from the FX thread it blocks. The screens are
                             additionally driven by a real-input TestFX test
                             (ReleaseManagerInteractionTest) covering create through to the code
                             reveal and the close-early confirmation. Never a wildcard: a single
                             '*' crosses path separators in JaCoCo and would silently
                             un-instrument the whole feature. -->
                        <exclude>client/features/release/ReleaseManagerView*</exclude>
                        <exclude>client/features/release/CreateReleaseDialog*</exclude>
<!-- E8 approval workflow: the three thin FX screens plus the one dialog that
                             needs an input and so could not reuse WarnConfirm. Every decision
                             they render lives in a measured logic class beside them —
                             ApprovalQueueSession, ExamPreviewSession, MyApprovalsSession,
                             ApprovalCopy — and the reject rule itself is in
                             common.dto.approval.ExamRejectRequest, which both tiers run and
                             which is covered. The screens are additionally driven by a
                             real-input TestFX test (ApprovalInteractionTest) covering queue →
                             preview → reject with a typed reason, and the preview rendering a
                             question with its four options. QuestionCardView is excluded on
                             the same terms as the other exam views it was extracted from.
                             Never a wildcard: a single '*' crosses path separators in JaCoCo
                             and would silently un-instrument the whole feature. -->
                        <exclude>client/features/results/MyGradesView*</exclude>
                        <exclude>client/features/results/CheckedFormView*</exclude>
                        <exclude>client/features/grading/GradingQueueView*</exclude>
                        <exclude>client/features/approval/ApprovalQueueView*</exclude>
                        <exclude>client/features/approval/ExamPreviewView*</exclude>
                        <exclude>client/features/approval/MyApprovalsView*</exclude>
                        <exclude>client/features/approval/RejectDialog*</exclude>
<!-- E14 teacher results: the one thin FX view. Every decision it renders is
                             made in TeacherResultsSession (selection, the T-10 toggle, the
                             print layout, the StatChartData mapping) or in ResultsCopy (the
                             six stat cards and every sentence), and both are measured. -->
                        <exclude>client/features/results/TeacherResultsView*</exclude>
<!-- E15 principal reports: the one thin FX view. Every decision it renders is
                             made in ReportsSession (the dimension and subject selection, the
                             row-to-chart flow, the print layout, the StatChartData mapping) or
                             in ReportsCopy (the six summary cards, the median band and every
                             sentence), and both are measured. -->
                        <exclude>client/features/reports/ReportsView*</exclude>
<!-- E15.2 principal data browser: the one thin FX view. Every decision it renders
                             is made in DataSession (which tab loads when, both filters, the
                             course options, which empty panel) or in DataCopy (every sentence,
                             the count line and every row label), and both are measured. The
                             tab enum beside them is measured too. -->
                        <exclude>client/features/data/DataView*</exclude>
                        <!-- E6.9's thin view; BankSession and BankCopy beside it are measured. -->
                        <exclude>client/features/bank/BankView*</exclude>
                        <!-- E6.10's thin view; QuestionEditorSession and -Copy are measured. -->
                        <exclude>client/features/bank/QuestionEditorView*</exclude>
<!-- E16 study bot: the four screens plus the three FX-only widgets they draw
     with. Every decision these render is made in BotChatModel, the four session
     classes and BotCopy, all of which are covered. Listed one by one, never a
     wildcard, so a new class in this package is covered until somebody argues
     otherwise in a diff. -->
                        <exclude>client/features/bot/BotChatView*</exclude>
                        <exclude>client/features/bot/BotManagerView*</exclude>
                        <exclude>client/features/bot/BotHistoryView*</exclude>
                        <exclude>client/features/bot/BotAnalyticsView*</exclude>
                        <exclude>client/features/bot/ChatBubble*</exclude>
                        <exclude>client/features/bot/TypingIndicator*</exclude>
                        <exclude>client/features/bot/ActivityBars*</exclude>
<!-- E4 design system: only thin FX view classes are excluded; all UI *logic*
                             (theme/, anim/Motion, components/logic/, shell state) IS measured -->
                        <exclude>client/ui/components/Buttons*</exclude>
                        <exclude>client/ui/components/CountdownTimer*</exclude>
                        <exclude>client/ui/components/DataTable*</exclude>
                        <exclude>client/ui/components/EmptyState*</exclude>
                        <exclude>client/ui/components/FormField*</exclude>
                        <exclude>client/ui/components/Icons*</exclude>
                        <!-- E6.10's two components. Note what these patterns do NOT reach:
                             client/ui/components/logic/ImagePickerLogic and
                             client/ui/components/logic/RadioGroupLogic sit one package deeper
                             and stay measured, which is the entire point of the split. The
                             ImageAction state machine in particular is the piece a defect
                             would hide in, and it is unit tested rather than excluded. -->
                        <exclude>client/ui/components/ImagePicker*</exclude>
<!-- UI wave 2's four new widgets, on exactly the terms the rest of this
                             list uses: each is a node builder over a measured logic class one
                             package deeper. Kicker is four lines over
                             components/logic/KickerText (the uppercase and the tracking JavaFX
                             CSS cannot do); Sparkbars is a loop over
                             components/logic/SparkbarSpec (which bar is the mode, how tall each
                             is); ProgressRing positions two arcs whose angles are
                             components/logic/RingGeometry's; NumberRoll clips two labels and
                             plays one timeline whose duration is Motion's. All four logic
                             classes stay measured and are unit tested, which is the entire
                             point of the split. Listed one by one, never a wildcard: a single
                             '*' crosses path separators in JaCoCo. -->
                        <exclude>client/ui/components/Kicker*</exclude>
                        <exclude>client/ui/components/NumberRoll*</exclude>
                        <exclude>client/ui/components/ProgressRing*</exclude>
                        <exclude>client/ui/components/Sparkbars*</exclude>
                        <exclude>client/ui/components/ProgressOverlay*</exclude>
                        <exclude>client/ui/components/RadioGroup*</exclude>
                        <exclude>client/ui/components/ReconnectBanner*</exclude>
                        <exclude>client/ui/components/RoleBadge*</exclude>
                        <exclude>client/ui/components/Skeletons*</exclude>
                        <exclude>client/ui/components/StatChart*</exclude>
                        <exclude>client/ui/components/StatusChip*</exclude>
                        <exclude>client/ui/components/ToastStack*</exclude>
                        <exclude>client/ui/components/WarnConfirm*</exclude>
                        <exclude>client/ui/gallery/**</exclude>
                        <exclude>client/ui/screen/**</exclude>
                        <exclude>client/ui/shell/AppShell*</exclude>
                        <exclude>client/ui/theme/ThemeManager*</exclude>
                        <exclude>client/ui/theme/ThemeControls*</exclude>
                        <exclude>client/ui/anim/Animations*</exclude>
                        <!-- legacy prototype, rewritten in E4/E6 -->
                        <exclude>client/core/ClientApp*</exclude>
                        <!-- legacy prototype, rewritten in E4/E6 -->
                        <exclude>client/core/ClientLauncher*</exclude>
                        <!-- legacy prototype, rewritten in E4/E6 -->
                        <exclude>client/core/Launcher*</exclude>
                        <!-- legacy prototype, rewritten in E4/E6 -->
                        <exclude>client/core/ScreenManager*</exclude>
                        <!-- legacy prototype, rewritten in E4/E6 -->
                        <!-- legacy prototype, rewritten in E4/E6 -->
                        <exclude>client/net/HSTSClient*</exclude>
                        <!-- Assembly glue: parses nothing, decides nothing. Every rule it
                             applies is in a measured class beside it: ServerArgs (the
                             headless / port switch parsing, tested), StartupMessages (the
                             migration failure sentence, tested), ConsoleModel/ConsoleSession
                             (every console decision) — and what remains here is the wiring
                             that needs a real database, a real socket and a real toolkit. -->
                        <exclude>server/core/ServerMain*</exclude>
                        <!-- legacy prototype, rewritten in E4/E6 -->
                        <exclude>server/core/HSTSServer*</exclude>
<!-- E19 server console: the three thin FX classes only, listed one by one.
                             Every decision they render lives in a measured class beside them —
                             ConsoleModel (the header, the address override, the button
                             labels), ConsoleSession (what every button does and answers),
                             ConsoleHealth + HealthSnapshot (the status cards), ConsoleClients
                             (the table's rows), LogTailModel + LogRingBuffer (the log pane),
                             NetworkDetector (the address ranking) — and the window is
                             additionally driven by a real-input TestFX test
                             (ServerConsoleInteractionTest). Never a wildcard: a single '*'
                             crosses path separators in JaCoCo and would silently
                             un-instrument the whole package. -->
                        <exclude>server/console/ConsoleView*</exclude>
                        <exclude>server/console/ConsoleTheme*</exclude>
                        <exclude>server/console/ServerConsoleApp*</exclude>
                        <!-- server/db/QuestionDAO* and server/db/DatabaseConfig* — the legacy
                             prototype pair — stood here until the retirement PR deleted both.
                             All server/db/** code (E2 entities, repositories, DbBootstrap,
                             allocators) IS measured. -->

                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.instruction.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Copy deployment properties beside the built JARs (E20.4).

                This execution copies the machine's REAL, gitignored
                server.properties / client.properties from the project root when
                they exist. A fresh clone and CI have neither, which is why the
                antrun execution below seeds the examples afterwards.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-deployment-properties</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>client.properties</include>
                                        <include>server.properties</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                First-run defaults beside the JARs (E20.4).

                Runs after the execution above, in the same phase, and seeds
                target/ from the *.properties.example files for whichever of the
                two is still missing. A fresh clone therefore has a runnable
                target/ directory without anybody hand-copying a file, and the
                real credentials of a machine that has them are never touched.

                Ant rather than a second copy-resources execution because the rule
                is "only when absent", and copy-resources can only express "only
                when the source is newer" — a timestamp comparison that would
                decide whether somebody's edited demo config survives a rebuild
                by which file git happened to check out last. <available> makes
                that a fact about existence instead of about clocks.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>seed-deployment-properties</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target xmlns:unless="ant:unless">
                                <available file="${project.build.directory}/server.properties"
                                           property="hsts.server.properties.present"/>
                                <available file="${project.build.directory}/client.properties"
                                           property="hsts.client.properties.present"/>
                                <copy unless:set="hsts.server.properties.present"
                                      file="${project.basedir}/server.properties.example"
                                      tofile="${project.build.directory}/server.properties"/>
                                <copy unless:set="hsts.client.properties.present"
                                      file="${project.basedir}/client.properties.example"
                                      tofile="${project.build.directory}/client.properties"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Two Fat JARs -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <!-- Server Fat JAR — includes JavaFX: the server console UI (E15)
                         is a JavaFX app (ARCHITECTURE §9). -->
                    <execution>
                        <id>server-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>${jar.server.name}</finalName>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>server.core.ServerMain</mainClass>
                                </transformer>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>

                    <!-- Client Fat JAR — no DB / ORM / bot server-only libraries -->
                    <execution>
                        <id>client-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>${jar.client.name}</finalName>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>client.core.ClientLauncher</mainClass>
                                </transformer>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <!--
                                Allow-list, not a deny-list: excluding only mysql /
                                hibernate / flyway / HikariCP / pdfbox / poi / anthropic-java
                                by name still dragged ~30 MB of THEIR transitives into the
                                client (kotlin + okhttp + protobuf behind anthropic-java,
                                byte-buddy + antlr + jakarta.* behind Hibernate, commons-* +
                                xmlbeans behind POI). Naming what the thin client may ship
                                keeps every server-only library out by construction.
                            -->
                            <artifactSet>
                                <includes>
                                    <include>${project.groupId}:${project.artifactId}</include>
                                    <include>org.openjfx:*</include>
                                    <include>io.github.mkpaz:*</include>
                                    <include>org.kordamp.ikonli:*</include>
                                    <include>org.greenrobot:eventbus-java</include>
                                    <include>at.favre.lib:*</include>
                                    <include>org.slf4j:*</include>
                                    <include>ch.qos.logback:*</include>
                                    <!-- jackson stays: the client may parse JSON payloads -->
                                    <include>com.fasterxml.jackson.core:*</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>server.properties</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Submission JAR names (E20.1).

            Activated by the presence of the -Djar.prefix switch on the command
            line, never by the <jar.prefix> default above: profile activation
            reads user and system properties only, so an ordinary `mvn package`
            still produces hsts-server.jar / hsts-client.jar and
            `mvn -Djar.prefix=G13 package` produces G13_Server.jar / G13_Client.jar.

            The two spellings differ deliberately. The submission names are fixed
            by the assignment (G<Num>_Server / G<Num>_Client) and the dev names
            are what every doc, script and habit in this repo points at, so
            neither is bent to match the other.
        -->
        <profile>
            <id>submission-jar-names</id>
            <activation>
                <property>
                    <name>jar.prefix</name>
                </property>
            </activation>
            <properties>
                <jar.server.name>${jar.prefix}_Server</jar.server.name>
                <jar.client.name>${jar.prefix}_Client</jar.client.name>
            </properties>
        </profile>
    </profiles>
</project>
